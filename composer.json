{
    "name": "lace/ainstruct",
    "license": "MIT",
    "description": "AI Instructions CLI — distribute per-framework AI instruction sets (AGENTS.md, CLAUDE.md, GEMINI.md, Cursor, Windsurf, Cline, Continue, Aider) into a consumer project from the current directory.",
    "type": "library",
    "keywords": [
        "ai",
        "instructions",
        "agents",
        "claude",
        "cursor",
        "windsurf",
        "cline",
        "aider"
    ],
    "homepage": "https://github.com/wahfix/ainstruct",
    "support": {
        "source": "https://github.com/wahfix/ainstruct"
    },
    "require": {
        "php": "^8.2",
        "illuminate/container": "^11.0|^12.0|^13.0",
        "laravel/prompts": "^0.3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Lace\\Ainstruct\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lace\\Ainstruct\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/ainstruct"
    ],
    "config": {
        "sort-packages": true
    }
}